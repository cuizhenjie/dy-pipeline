{
  "name": "dsh-workbench-omni-marketing",
  "version": "0.1.0",
  "description": "Omni-channel marketing operations agent workbench: dashboard, channels, campaigns, AI agents, materials, publishing, leads and reports.",
  "type": "module",
  "main": "./dsh/index.js",
  "exports": {
    ".": "./dsh/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "dsh",
    "lib",
    "cordis.patch.yml",
    "README.md",
    "DESIGN.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "node scripts/build.mjs",
    "test": "node scripts/build.mjs && node --test test/*.test.mjs"
  },
  "license": "MIT",
  "author": "DataElement",
  "keywords": [
    "dsh-plugin",
    "workbench",
    "marketing",
    "omni-channel",
    "agent"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "dsh-desktop-workbenches"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.6-alpha.1"
  },
  "devDependencies": {
    "esbuild": "0.25.5",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2 || ^4.0.6-alpha.1",
    "@deepseek-ai/dsh-client-connection": "^0.1.2-rc.1 || ^0.1.7-rc.1 || ^0.1.7-rc.2 || ^0.2.0-rc.1 || ^0.2.1-rc.1 || ^0.2.2-alpha.2"
  }
}
